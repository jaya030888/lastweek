# Her Voice Server Environment Configuration Example
# Copy to .env and configure appropriately for your environment

PORT=5000
NODE_ENV=development

# Database connection string (SQLite for local, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Local Ollama AI Engine Settings
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3"

# Allowed CORS origins (comma-separated for multi-origins in production)
CLIENT_URL="http://localhost:3000"

